{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duz-ui-gallery",
  "main": "./workers/app.ts",
  "routes": [{ "pattern": "ui.duz52.com", "custom_domain": true }],
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
