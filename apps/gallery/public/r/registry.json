{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "agent-ui",
  "homepage": "https://agent-ui.dev",
  "items": [
    {
      "name": "agent-ui-runtime",
      "type": "registry:lib",
      "title": "Agent UI Runtime",
      "description": "The capability kernel, registry, WebMCP bridge and hooks that every agent-native component binds to.",
      "dependencies": [],
      "registryDependencies": []
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper that merges Tailwind class names, required by every component.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "registryDependencies": []
    },
    {
      "name": "use-mobile",
      "type": "registry:hook",
      "title": "use-mobile",
      "description": "A React hook that reports whether the viewport is below the mobile breakpoint.",
      "dependencies": [],
      "registryDependencies": []
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A polymorphic button with variant and size presets, styled for agent-driven interfaces.",
      "dependencies": [
        "radix-ui",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "utils"
      ],
      "agentUi": {
        "status": "explicit-semantics"
      }
    },
    {
      "name": "label",
      "type": "registry:ui",
      "title": "Label",
      "description": "An accessible form label built on Radix Label.",
      "dependencies": [
        "radix-ui"
      ],
      "registryDependencies": [
        "utils"
      ],
      "agentUi": {
        "status": "presentation"
      }
    },
    {
      "name": "separator",
      "type": "registry:ui",
      "title": "Separator",
      "description": "A horizontal or vertical divider that visually separates content sections.",
      "dependencies": [
        "radix-ui"
      ],
      "registryDependencies": [
        "utils"
      ],
      "agentUi": {
        "status": "presentation"
      }
    },
    {
      "name": "skeleton",
      "type": "registry:ui",
      "title": "Skeleton",
      "description": "A pulsing placeholder element that indicates content is loading.",
      "dependencies": [],
      "registryDependencies": [
        "utils"
      ],
      "agentUi": {
        "status": "presentation"
      }
    },
    {
      "name": "tooltip",
      "type": "registry:ui",
      "title": "Tooltip",
      "description": "A hover-triggered popover that displays contextual information near an anchor element.",
      "dependencies": [
        "radix-ui"
      ],
      "registryDependencies": [
        "utils"
      ],
      "agentUi": {
        "status": "presentation"
      }
    },
    {
      "name": "table",
      "type": "registry:ui",
      "title": "Table",
      "description": "Primitive table elements with consistent styling, used as the rendering layer for DataTable.",
      "dependencies": [],
      "registryDependencies": [
        "utils"
      ],
      "agentUi": {
        "status": "presentation"
      }
    },
    {
      "name": "tabs",
      "type": "registry:ui",
      "title": "Tabs",
      "description": "A tabbed container whose active tab is readable and selectable by an agent.",
      "dependencies": [
        "radix-ui",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "utils",
        "agent-ui-runtime"
      ],
      "agentUi": {
        "capabilities": [
          {
            "kind": "tabs",
            "actions": [
              "select"
            ]
          }
        ],
        "status": "agent-native"
      }
    },
    {
      "name": "select",
      "type": "registry:ui",
      "title": "Select",
      "description": "A dropdown select whose chosen value and options are readable and settable by an agent.",
      "dependencies": [
        "radix-ui",
        "lucide-react"
      ],
      "registryDependencies": [
        "utils",
        "agent-ui-runtime"
      ],
      "agentUi": {
        "capabilities": [
          {
            "kind": "select",
            "actions": [
              "choose",
              "clear"
            ]
          }
        ],
        "status": "agent-native"
      }
    },
    {
      "name": "checkbox",
