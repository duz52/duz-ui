{
  "name": "duz-ui",
  "version": "0.1.0",
  "description": "An agent-native component library. shadcn-compatible React components that expose their capabilities to WebMCP agents.",
  "keywords": [
    "webmcp",
    "mcp",
    "agent",
    "agentic",
    "ai",
    "shadcn",
    "react",
    "components",
    "ui",
    "accessibility"
  ],
  "homepage": "https://ui.duz52.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duz52/duz-ui.git"
  },
  "bugs": {
    "url": "https://github.com/duz52/duz-ui/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "duz-ui": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate:fingerprints": "tsx scripts/generate-stock-fingerprints.ts",
    "pretest": "pnpm --filter @duz-ui/registry build && pnpm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "ts-morph": "^28.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
