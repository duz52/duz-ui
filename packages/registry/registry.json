{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "agent-ui",
  "homepage": "https://agent-ui.dev",
  "items": [
    {
      "name": "agent-ui-runtime",
      "type": "registry:lib",
      "title": "Agent UI Runtime",
      "description": "The capability kernel, registry, WebMCP bridge and hooks that every agent-native component binds to.",
      "dependencies": [],
      "registryDependencies": [],
      "sources": [
        "lib/agent-ui/agent-action.tsx",
        "lib/agent-ui/agent-identity.ts",
        "lib/agent-ui/capability.ts",
        "lib/agent-ui/registry.ts",
        "lib/agent-ui/runtime.ts",
        "lib/agent-ui/tools.ts",
        "lib/agent-ui/use-capabilities.ts",
        "lib/agent-ui/use-capability.ts",
        "lib/agent-ui/use-controllable-state.ts",
        "lib/agent-ui/use-merged-ref.ts",
        "lib/agent-ui/validate.ts",
        "lib/agent-ui/webmcp.ts"
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn helper that merges Tailwind class names, required by every component.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "registryDependencies": [],
      "sources": [
        "lib/utils.ts"
      ]
    },
    {
      "name": "use-mobile",
      "type": "registry:hook",
      "title": "use-mobile",
      "description": "A React hook that reports whether the viewport is below the mobile breakpoint.",
      "dependencies": [],
      "registryDependencies": [],
      "sources": [
        "hooks/use-mobile.ts"
      ]
    },
