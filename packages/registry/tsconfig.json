{
  // Editor default. Per-base checking is done by tsconfig.radix.json and
  // tsconfig.base.json beside this file, which extend it and map
  // "@/components/ui/*" to their own base tree.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "webmcp-types",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/components/ui/*": [
        "./src/bases/radix/ui/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ]
    }
  },
  "include": [
    "src",
    "build.ts"
  ]
}
